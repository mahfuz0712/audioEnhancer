#include <windows.h>
#include "version.h"

// Application icon (used by Explorer, taskbar, window title bar)
1 ICON "assets/app.ico"

// Dimmed icon used by the system tray while the enhancer is off
2 ICON "assets/app_off.ico"

// Version info (shown in the exe's Properties > Details; AudioEnhancer.iss reads ProductVersion from here)
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    APP_VERSION_MAJOR, APP_VERSION_MINOR, APP_VERSION_PATCH, 0
 PRODUCTVERSION APP_VERSION_MAJOR, APP_VERSION_MINOR, APP_VERSION_PATCH, 0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Mahfuz Rahman"
            VALUE "FileDescription",  "Audio Enhancer"
            VALUE "FileVersion",      APP_VERSION_STR
            VALUE "InternalName",     "AudioEnhancer"
            VALUE "OriginalFilename", "AudioEnhancer.exe"
            VALUE "ProductName",      "Audio Enhancer"
            VALUE "ProductVersion",   APP_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
